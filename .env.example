# Copy to .env and fill in. .env is gitignored.

PORT=3001

# Live sessions (Gemini Live: transcription and spoken nudges). Required for /session.
GEMINI_API_KEY=

# Field notes after a session: gemini | openrouter | anthropic
LLM_PROVIDER=gemini

# gemini: uses GEMINI_API_KEY above. Optional model override.
# GEMINI_TEARDOWN_MODEL=gemini-3.6-flash

# openrouter: free models rotate and get rate-limited, so list several in fallback order.
# Pick current IDs from https://openrouter.ai/models (comma separated).
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=

# anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional: low | medium | high | xhigh | max (defaults to high on claude-opus-5-5)
# ANTHROPIC_EFFORT=
# Server-side refusal fallback is on by default; set to off to disable.
# ANTHROPIC_FALLBACKS=on
