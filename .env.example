# Copy to .env and fill in. .env is gitignored.

PORT=3001

# Live transcription (Deepgram Nova-3). Required for /session. The key needs the Member role
# or higher so the server can issue the browser short-lived tokens; it never reaches the browser.
DEEPGRAM_API_KEY=

# Gemini, for field notes (see LLM_PROVIDER below).
GEMINI_API_KEY=

# Field notes after a session: gemini | openrouter | anthropic
LLM_PROVIDER=gemini
# Providers to fall back to, in order, when the first is still failing after retries
# (429/5xx/network errors are retried at about 1 s, 3 s and 7 s). Providers without a key are skipped.
LLM_FALLBACKS=gemini,anthropic,openrouter

# gemini: uses GEMINI_API_KEY above. Optional model override.
# GEMINI_TEARDOWN_MODEL=gemini-3.6-flash

# openrouter: free models rotate and get rate-limited, so list several in fallback order.
# Pick current IDs from https://openrouter.ai/models (comma separated).
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=

# anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional: low | medium | high | xhigh | max (defaults to high on claude-opus-5-5)
# ANTHROPIC_EFFORT=
# Server-side refusal fallback is on by default; set to off to disable.
# ANTHROPIC_FALLBACKS=on

# --- Usage limits (for a public deploy; defaults shown) ---------------------------------------
# Counters are shared through Upstash Redis when these are set (on Vercel, the Upstash
# Marketplace integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; either works).
# Without them, limits are kept in memory, which is fine for one local server.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Site-wide live sessions per UTC day: the main cost guard. 0 turns live sessions off.
# DAILY_SESSION_CAP=300
# Per visitor (anonymous cookie) and per IP.
# SESSIONS_PER_VISITOR_PER_HOUR=12
# SESSIONS_PER_VISITOR_PER_DAY=30
# SESSIONS_PER_IP_PER_HOUR=40
# Field notes and "tightened answer" calls (a session makes two).
# WRITES_PER_VISITOR_PER_HOUR=40
# WRITES_PER_IP_PER_HOUR=120
# Every live session also stops at 10 minutes (set in the app).
